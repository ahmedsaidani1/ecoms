PORT=4000

# Base MongoDB Atlas
MONGODB_URI="mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net"
MONGODB_DB="econs"

# Tableau de bord : a changer absolument en production
ADMIN_PASSWORD="choisissez-un-mot-de-passe-solide"
JWT_SECRET="une-longue-chaine-aleatoire"

# Sites autorises a appeler l'API, separes par des virgules, sans / final
CLIENT_ORIGIN="http://localhost:5173"

# Production uniquement : stockage des photos et videos sur Cloudinary
# (Tableau de bord Cloudinary > API Keys > "API environment variable").
# Laisser vide en local : les fichiers vont dans server/uploads.
CLOUDINARY_URL=
